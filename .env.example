# Copiado para .env pelo scripts/bootstrap-vps.sh, que também gera as senhas.
GCP_PROJECT_ID=seu-projeto-gcp
BQ_LOCATION=US

# UID do usuário da VPS (o bootstrap preenche com `id -u`)
AIRFLOW_UID=50000

POSTGRES_PASSWORD=troque-me
AIRFLOW_JWT_SECRET=troque-me

# Anos de histórico baixados a cada execução (séries diárias do SGS aceitam no máximo 10)
SGS_ANOS_HISTORICO=5

# Só na VPS: liga o dashboard ao Caddy (rede externa `cadencia`)
# COMPOSE_FILE=docker-compose.yaml:docker-compose.vps.yaml
